{
  "name": "sema-metra--alchemica-mundi",
  "version": "1.0.0",
  "description": "sēma-mētra--alchemica-mundi: Signal-Matrix for World-Alchemy",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sema": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && cp -r data dist/",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts"
  },
  "keywords": [
    "matrix",
    "synthesis",
    "signal",
    "alchemy",
    "modulation",
    "patchbay"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4444J99/sema-metra--alchemica-mundi.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "commander": "15.1.0",
    "tone": "^15.0.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
