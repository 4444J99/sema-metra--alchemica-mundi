{
  "name": "sema-metra--alchemica-mundi",
  "version": "1.0.0",
  "description": "sēma-mētra--alchemica-mundi: Signal-Matrix for World-Alchemy",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sema": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp -r data dist/",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build",
    "smoke": "node ./dist/cli/index.js --help && node -e \"import('./dist/index.js').then(async m => { const mundi = await m.createAlchemicaMundi(); if (!m.validateAxiomCompliance(mundi).valid) process.exit(1); console.log('SMOKE TEST PASSED: sema-metra--alchemica-mundi active and compliant'); })\"",
    "release:pack": "npm run build && npm pack"
  },
  "keywords": [
    "matrix",
    "synthesis",
    "signal",
    "alchemy",
    "modulation",
    "patchbay"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "tone": "^15.0.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
